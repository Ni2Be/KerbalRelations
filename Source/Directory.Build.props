<Project>
  <!-- Put a machine-specific KSPRoot in KSPRoot.user.props (git-ignored) to override the default below. -->
  <Import Project="$(MSBuildThisFileDirectory)KSPRoot.user.props" Condition="Exists('$(MSBuildThisFileDirectory)KSPRoot.user.props')" />
  <PropertyGroup>
    <KSPRoot Condition="'$(KSPRoot)' == ''">E:\SteamLibrary\steamapps\common\Kerbal Space Program</KSPRoot>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>
